# Server-only Supabase credentials used to verify the signed-in Operations HQ owner.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# GitHub App OAuth configuration. Never expose these as NEXT_PUBLIC_* variables.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=
# Generate a unique random secret with at least 32 characters (for example: openssl rand -hex 32).
GITHUB_APP_STATE_SECRET=
